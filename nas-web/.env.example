# Shared PIN lock for the CinaRip library splash.
# On the NAS: save this as .env next to docker-compose.yml, fill APP_PIN and
# SESSION_SECRET, then: sudo docker compose up -d --force-recreate
# Do not commit .env. Do not put the real PIN in git.
APP_PIN=
# CINARIP_PIN=
SESSION_SECRET=
# openssl rand -hex 32
SESSION_TTL_MINUTES=30
# SESSION_TTL_SEC=
